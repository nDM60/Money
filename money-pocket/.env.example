# ---------- Core ----------
# PostgreSQL connection string. Leave empty for zero-config local mode
# (embedded PostgreSQL via PGlite, stored in ./.data/pglite).
DATABASE_URL=
# Public URL of the app (used for OAuth redirects), e.g. https://money.example.com
APP_URL=http://localhost:3000
# Random secret (>= 32 chars) used to encrypt OAuth tokens at rest.  openssl rand -base64 48
APP_SECRET=

# ---------- AI assistant & receipt/banknote recognition (Claude) ----------
# Without it, the assistant uses the built-in multilingual rule engine and the
# scanner falls back to manual entry.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
ANTHROPIC_MODEL=

# ---------- Scheduler (daily/weekly/monthly summaries, bill reminders, auto-post, sheet sync) ----------
# Protects /api/cron/tick. Call it every 5–15 minutes with:  Authorization: Bearer $CRON_SECRET
CRON_SECRET=
# Self-hosted alternative: run the scheduler inside the Node server process.
INTERNAL_SCHEDULER=false
SCHEDULER_INTERVAL_MIN=5

# ---------- Web Push ----------
# Generate with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------- Email notifications (optional, via Resend) ----------
RESEND_API_KEY=
EMAIL_FROM=

# ---------- Google Sheets ----------
# OAuth client (type "Web application") with redirect URI  $APP_URL/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
